<mujoco model="exo_elbow">
  <!--
    Single-DOF elbow exoskeleton.
      - Upper arm is fixed (hangs vertically from a fixed shoulder).
      - Forearm + hand + exo cuff rotate about the elbow hinge.
      - Elbow angle q: 0 = arm fully extended (forearm pointing down),
                       +pi/2 = forearm horizontal, flexion is positive.
    Two actuators drive the same joint:
      1. "biceps"   : the human. Activation in [0,1] with first-order
                      activation dynamics (tau = 40 ms). Flexion only.
                      Its control is the hidden neural drive that the
                      EMG sensor observes (noisy, delayed).
      2. "exo_motor": the RL agent. Normalized command in [-1,1],
                      gear = peak motor torque at the joint (N*m).
    Joint armature models the reflected rotor inertia of the geared motor;
    damping/frictionloss model the gearbox + soft tissue losses.
    Tune all numbers below to your hardware.
  -->
  <!-- MuJoCo defaults to degrees for joint ranges; we work in radians everywhere -->
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <geom contype="0" conaffinity="0"/>
  </default>

  <worldbody>
    <light pos="0 -1 2" dir="0 0.5 -1" directional="true"/>
    <geom name="floor" type="plane" size="1 1 0.05" pos="0 0 0" material="groundplane"/>

    <!-- shoulder mount -->
    <body name="shoulder" pos="0 0 1.3">
      <geom name="shoulder_geom" type="sphere" size="0.05" rgba="0.6 0.6 0.6 1"/>

      <!-- upper arm (fixed), 0.30 m long -->
      <geom name="upper_arm" type="capsule" fromto="0 0 0  0 0 -0.30" size="0.04" rgba="0.9 0.75 0.6 1"/>
      <geom name="upper_cuff" type="box" pos="0 0 -0.18" size="0.05 0.05 0.06" rgba="0.2 0.2 0.25 0.8"/>

      <body name="forearm" pos="0 0 -0.30">
        <!-- axis -y so that positive angle swings the forearm toward +x (flexion) -->
        <joint name="elbow" type="hinge" axis="0 -1 0" range="0 2.5" limited="true"
               damping="0.05" frictionloss="0.02" armature="0.01"/>
        <geom name="elbow_motor" type="cylinder" fromto="0 -0.07 0  0 -0.03 0" size="0.035"
              rgba="0.15 0.15 0.15 1" mass="0"/>
        <!-- human forearm: ~1.2 kg, 0.25 m -->
        <geom name="forearm_geom" type="capsule" fromto="0 0 0  0 0 -0.25" size="0.035"
              mass="1.2" rgba="0.9 0.75 0.6 1"/>
        <!-- hand: ~0.4 kg -->
        <geom name="hand_geom" type="ellipsoid" pos="0 0 -0.31" size="0.03 0.045 0.06"
              mass="0.4" rgba="0.9 0.75 0.6 1"/>
        <!-- exo forearm cuff/brace: ~0.3 kg -->
        <geom name="exo_cuff" type="box" pos="0 0 -0.14" size="0.045 0.045 0.08"
              mass="0.3" rgba="0.2 0.2 0.25 0.8"/>
        <!-- payload site (attach a weight here via env options) -->
        <site name="hand_site" pos="0 0 -0.31" size="0.01"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- human biceps: torque = gain * activation, activation filters ctrl (tau 40 ms) -->
    <general name="biceps" joint="elbow" dyntype="filter" dynprm="0.04"
             gainprm="2.0" ctrlrange="0 1" ctrllimited="true"/>
    <!-- exoskeleton motor: torque = 6 N*m * ctrl -->
    <motor name="exo_motor" joint="elbow" gear="6.0" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>

  <sensor>
    <jointpos name="elbow_pos" joint="elbow"/>
    <jointvel name="elbow_vel" joint="elbow"/>
    <actuatorfrc name="biceps_torque" actuator="biceps"/>
    <actuatorfrc name="motor_torque" actuator="exo_motor"/>
  </sensor>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="90" elevation="-10"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
</mujoco>
